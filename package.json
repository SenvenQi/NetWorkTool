{
  "name": "tool",
  "version": "1.0.0",
  "description": "测试整合版",
  "main": "./dist/main.js",
  "private": true,
  "scripts": {
    "initPackage": "npm ci && npm --prefix frontend/tool ci",
    "dev": "concurrently \"cross-env BROWSER=none npm --prefix frontend/tool start\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development npm start\"",
    "build": "npm run build:main && npm --prefix frontend/tool run build",
    "watch": "tsc -w",
    "lint": "eslint --ext .ts src",
    "start": "tsc --sourceRoot ./src/background && electron ./dist/main.js",
    "pack": "npm run build && electron-builder --win nsis --x64 --publish never",
    "build:main": "tsc",
    "test": "npm run build:main && node --test tests/*.test.cjs",
    "postinstall": "electron-rebuild --only better-sqlite3",
    "test:electron": "electron tests/electron-smoke.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "test:database": "electron tests/database-concurrency.cjs"
  },
  "keywords": [
    "Electron",
    "start",
    "tutorial",
    "typescript"
  ],
  "author": "SevenQi",
  "license": "private",
  "devDependencies": {
    "@types/formidable": "^3.4.6",
    "@types/node": "^16.18.0",
    "@typescript-eslint/eslint-plugin": "^4.33.0",
    "@typescript-eslint/parser": "^4.33.0",
    "concurrently": "^6.4.0",
    "cross-env": "^7.0.3",
    "electron": "^43.8.10",
    "electron-builder": "^26.18.0",
    "eslint": "^7.32.0",
    "typescript": "~4.9.5",
    "wait-on": "^9.5.1",
    "@electron/rebuild": "^4.2.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "formidable": "^3.5.4",
    "iconv-lite": "^0.6.3",
    "node-hid": "^3.3.0",
    "reflect-metadata": "^0.1.13",
    "serialport": "^13.0.0",
    "typeorm": "^0.3.28"
  },
  "build": {
    "appId": "Tool",
    "productName": "网络测试工具",
    "copyright": "Copyright © 2021 ${author}",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      {
        "from": "frontend/tool/build",
        "to": "dist/service/out",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "frontend/tool/public/logo512.png"
    },
    "extends": null,
    "beforePack": "./scripts/rebuild.cjs",
    "npmRebuild": false
  },
  "overrides": {
    "typeorm": {
      "glob": "^14.0.6"
    },
    "minimatch@>=7": "^11.0.8",
    "brace-expansion@1": "^1.1.22"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
